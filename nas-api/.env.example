# Copier vers `.env` (jamais commité) et adapter. Voir TUTO-NAS.md, étape 6.

# Dossier images PHYSIQUE sur le NAS (celui servi par le conteneur nginx `:ro`,
# destination du miroir) — aucun défaut : le compose refuse de démarrer sans.
IMAGES_PATH=/srv/dev-disk-by-uuid-xxxx-xxxx/Nas/Dev/poroiniens

# Port d'écoute LAN (changer si pris ; reporter dans la règle NPM `/api`).
API_PORT=8660

# Clé d'API (conseillé) : exigée pour `/move`, et pour toutes les routes si
# définie. Reporter la MÊME valeur dans `.env.local` / Vercel (`NAS_API_KEY`),
# sinon le site ne pourra plus interroger l'API.
NAS_API_KEY=

# Quota par IP et par minute (`0` = désactivé). L'import complet liste des
# milliers de dossiers : ne pas descendre sous 300.
RATE_LIMIT_PER_MIN=600
