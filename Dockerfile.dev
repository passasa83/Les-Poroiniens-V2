# Dev uniquement : `next dev` dans un conteneur pour héberger le site de
# développement sur le NAS OpenMediaVault (voir docker-compose.dev.yml).
# La prod reste sur Vercel et n'utilise jamais ce fichier.
FROM node:22-bookworm

WORKDIR /app

# Dépendances d'abord (cache Docker) : on ne les refait pas à chaque
# changement de code, seulement quand package*.json bouge.
COPY package*.json ./
RUN npm ci

# Code du dépôt (clone git sur le NAS, pas de montage SMB).
COPY . .

EXPOSE 3000

# -H 0.0.0.0 : Next 16 écoute sur toutes les interfaces du conteneur
# (vérifié dans `next dev --help`).
CMD ["npm", "run", "dev", "--", "-H", "0.0.0.0", "-p", "3000"]
