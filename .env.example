# ── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Les Poroiniens
# Secret utilisé pour signer les cookies de session de démo (sans Appwrite)
AUTH_SECRET=changez-moi-par-une-chaine-aleatoire-de-32-caracteres

# ── Appwrite (auto-hébergé) ─────────────────────────────────────────────
# Renseignés -> le site utilise Appwrite (auth, base, storage).
# Vides -> bascule automatique sur le jeu de données de démonstration.
APPWRITE_ENDPOINT=https://appwrite.monhomelabdechlag.duckdns.org/v1
APPWRITE_PROJECT_ID=6ac1adfd003a1db10da2
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=poroiniens
APPWRITE_BUCKET_AVATARS=avatars

# ── NAS (pages de scans) ────────────────────────────────────────────────
# URL de base de l'API du NAS. Vide -> pages de démonstration locales.
NAS_API_URL=
NAS_API_KEY=
# CDN devant le NAS (ex: https://cdn.votresite.tld). Vide -> proxy local /api/image.
CDN_BASE_URL=

# ── Google Drive (ressources de séries uniquement) ──────────────────────
# Côté serveur uniquement, jamais exposé au client.
GOOGLE_DRIVE_SERVICE_ACCOUNT=
GOOGLE_DRIVE_ROOT_FOLDER=

# ── Divers ──────────────────────────────────────────────────────────────
# Secret des crons Vercel (x-vercel-cron-secret)
CRON_SECRET=
# Durée de validité du gate +18 pour les visiteurs, en jours
ADULT_GATE_TTL_DAYS=30
