# Modèle d'environnement — copier vers `.env.local` (non versionné) puis
# coller le même bloc dans Vercel → Project → Settings → Environment Variables.
# Pour l'auto-hébergement (TUTO-NAS.md, annexe C) : `cp .env.example .env`,
# fichier lu par docker-compose.prod.yml (interpolation + env_file) et jamais
# versionné ni copié dans l'image Docker.
# Aucune valeur de ce fichier n'est secrète : les secrets s'y ajoutent à la main.

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Les Poroiniens
NEXT_PUBLIC_CONTACT_EMAIL=
# Signature des cookies de session et du gate +18
AUTH_SECRET=change-me
# Durée du gate +18 en jours (défaut 30)
ADULT_GATE_TTL_DAYS=30
# Secret des crons : Vercel l'envoie automatiquement en `Authorization: Bearer`
CRON_SECRET=change-me
# Masquage du jeu de démo (demo-gate.ts) : Vercel le définit tout seul en
# prod ; sur la NAS (hors Vercel) il FAUT cette ligne, sinon les séries de
# démonstration apparaissent. À builder et à servir avec la valeur `production`.
VERCEL_ENV=production

# ── Appwrite auto-hébergé (obligatoire) ─────────────────────────────────────
APPWRITE_ENDPOINT=https://appwrite.example.com/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=poroiniens
APPWRITE_BUCKET_AVATARS=avatars
# Profil Gérant créé/promu par `npm run appwrite:setup`
APPWRITE_OWNER_EMAIL=
APPWRITE_OWNER_PASSWORD=

# ── Source d'images ImgChest (active : un album = un chapitre) ───────────────
# Compte du Gérant : requis pour lister ses albums dans l'espace d'import.
# La lecture d'un album est publique : elle fonctionne sans aucune de ces clés.
IMG_CHEST_USERNAME=
# Clé d'API du compte, envoyée en `Authorization: Bearer` si elle est renseignée
IMG_CHEST_API_KEY=
# Surcharge du domaine (miroir, proxy interne) — défaut https://imgchest.com
IMG_CHEST_API_BASE=

# ── Système d'images NAS → Cloudflare ───────────────────────────────────────
# Domaine qui sert les fichiers (`img.`) : URLs = `${IMG_BASE_URL}/${chemin}`
IMG_BASE_URL=
# API privée de listing du NAS (`api-img.`), appelée **côté serveur uniquement**
NAS_API_BASE=
# Service token Cloudflare Access sur `api-img.` (recommandé)
NAS_API_CLIENT_ID=
NAS_API_CLIENT_SECRET=
# Alternative à Access : clé d'API du NAS
NAS_API_KEY=
# HMAC des URLs à 10 minutes (chapitres non publiés / aperçus Gérant)
IMG_SIGNING_SECRET=change-me
# Purge ciblée du cache à la publication (best effort)
CF_API_TOKEN=
CF_ZONE_ID=
# Opt-in : flou serveur des couvertures +18 via `/cdn-cgi/image/`
# (activer seulement si la transformation d'images fonctionne sur `img.`)
IMG_CDN_BLUR=0
# Seuil d'alerte du cron de santé sur les erreurs d'images (48 h)
IMAGE_ERROR_ALERT=20
# Alias hérités, conservés pour compatibilité
CDN_BASE_URL=
NAS_API_URL=
NAS_PAGE_BASE_URL=

# ── Options (non requises) ──────────────────────────────────────────────────
# Indexation d'un cloud externe, réservée hors MVP
GOOGLE_DRIVE_SERVICE_ACCOUNT=
GOOGLE_DRIVE_FOLDER_ID=
# Moteur de challenge anti-robots : les deux clés sont nécessaires.
# Sans clé publique, le widget n'apparaît pas et le bandeau « à configurer »
# reste affiché ; sans les deux, la vérification est sautée côté serveur.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Statut affiché au Gérant (aucun envoi de mail n'est branché à ce jour)
SMTP_HOST=
RESEND_API_KEY=
# Connexion Discord (OAuth2) : deux clés du portail développeur Discord.
# URI de redirection à inscrire, à l'identique :
#   {NEXT_PUBLIC_SITE_URL}/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Démonstration hors ligne (npm run dev sans Appwrite)
DEMO_MODE=
DEMO_PASSWORD=
